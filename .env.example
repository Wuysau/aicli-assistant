VITE_APP_NAME=AI CLI Assistant
VITE_APP_ENV=local
VITE_MOCK_DELAY_MS=450

# Optional AI supplement settings.
# Keep disabled if you only want the local rule-based workflow.
# These values are read only by the Tauri backend.
# Do not prefix them with VITE_, otherwise they may be exposed to the frontend bundle.
AICLI_AI_MODE=disabled
AICLI_AI_BASE_URL=https://api.openai.com/v1
AICLI_AI_MODEL=gpt-4.1-mini
AICLI_AI_API_KEY=
